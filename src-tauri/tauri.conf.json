{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moonshine会议助手",
  "version": "2.0.0",
  "identifier": "com.moonshine.meeting-assistant",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Moonshine 会议助手",
        "width": 1080,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#09090e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/icon.png",
      "icons/icon.svg"
    ],
    "resources": [
      "../python/engine_service.py",
      "../python/requirements.txt"
    ]
  }
}
